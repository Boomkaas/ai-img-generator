# Copy to infra/.env.prod on the manager (machine A) and fill in. Never commit infra/.env.prod.
# scripts/swarm/deploy.sh loads it before docker stack deploy.
# Generate each secret with: openssl rand -hex 32   (hex keeps the Redis and Postgres URLs valid)

# Where the images come from: REGISTRY/imagegen-api:TAG and so on. deploy.sh sets TAG from its argument.
REGISTRY=local

# The public name the site is served under; ALLOWED_ORIGINS becomes https://DOMAIN.
DOMAIN=localhost

REDIS_PASSWORD=
PG_PASSWORD=
MINIO_PASSWORD=
# HMAC key for access tokens, at least 32 characters.
JWT_SECRET=

# One API server per app machine.
API_REPLICAS=2
# Worker limits for the autoscaler; MAX_WORKERS is the sum over the app machines from scripts/calibrate.py.
MIN_WORKERS=1
MAX_WORKERS=4

# The Swarm config holding Nginx's upstream list; scripts/swarm/add-machine.md bumps its version.
NGINX_UPSTREAMS_CONFIG=nginx_upstreams

# Time zone of the times on the admin panel.
TZ=UTC
