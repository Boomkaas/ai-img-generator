# Copy to .env for local development. Defaults match infra/compose.dev.yml. Never commit .env.

# --- Database ---
# Postgres connection string (SQLAlchemy + psycopg 3).
DATABASE_URL=postgresql+psycopg://imagegen:imagegen@localhost:5432/imagegen
# Connections per process in the SQLAlchemy pool (API 5, worker 1).
DB_POOL_SIZE=5
# Seconds a request waits for a free pooled connection before failing.
DB_POOL_TIMEOUT_S=5

# --- Redis ---
# Celery broker (the job queue).
BROKER_URL=redis://localhost:6379/0
# Live state: progress, cancel flags, heartbeats, pub/sub (same Redis instance).
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO) ---
# S3-compatible endpoint for result images.
S3_ENDPOINT=http://localhost:9000
# MinIO access key (dev root user).
S3_ACCESS_KEY=imagegen
# MinIO secret key (dev only; use a real secret in production).
S3_SECRET_KEY=imagegen-dev-secret
# Bucket that holds result images.
S3_BUCKET=imagegen

# --- Auth ---
# HMAC key that signs access-token JWTs (at least 32 characters); generate a random one outside development.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Set the Secure flag on auth cookies (false only for plain-HTTP local development).
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS and the WebSocket Origin check.
ALLOWED_ORIGINS=http://localhost:5173

# --- Worker ---
# Machine name shown in heartbeats and the admin panel.
MACHINE_NAME=local
# Worker name, normally <machine>-worker-<slot> (set by the stack file).
WORKER_NAME=local-worker-1
# Pipeline implementation: "fake" (no weights, sleeps) or "real" (Stable Diffusion 1.5).
PIPELINE=fake
# Seconds per denoising step for the fake pipeline.
FAKE_STEP_SECONDS=1
# Directory with the Stable Diffusion 1.5 weights (real pipeline only).
MODEL_DIR=/models/sd15
# torch.set_num_threads for each worker process.
WORKER_THREADS=2
# Extra pause after every denoising step; 0 turns it off.
STEP_DELAY_SECONDS=0
# Denoising steps per job (fixed on the server).
NUM_STEPS=25

# --- Timing and estimates ---
# Measured runtime of a 768 px job on the slowest app machine; drives every timeout.
MEASURED_MAX_RUNTIME_S=1080
# Seconds per cost unit (one 512 px job) used until enough real jobs have finished.
CALIBRATED_SECONDS_PER_COST_UNIT=480

# --- Controller / autoscaler ---
# Scaling backend: "swarm" (Docker Swarm service) or "none" (autoscaling off).
SCALER=none
# Swarm service whose replica count the autoscaler changes.
WORKER_SERVICE=imagegen_worker
# Lowest number of workers the autoscaler keeps.
MIN_WORKERS=1
# Highest number of workers the autoscaler may start (from the sizing rule, architecture §7.1).
MAX_WORKERS=4
# Optional webhook that receives autoscaler alerts; empty disables it.
ALERT_WEBHOOK_URL=
